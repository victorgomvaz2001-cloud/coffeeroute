NODE_ENV=development
PORT=3000
# Docker Compose maps Postgres to 5433 and Redis to 6380 to avoid clashing with local installs.
DATABASE_URL=postgresql://coffeeroute:coffeeroute@localhost:5433/coffeeroute
REDIS_URL=redis://localhost:6380
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3001,http://localhost:8081
THROTTLE_LIMIT_PER_MINUTE=100
SENTRY_DSN=
# Used by `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@coffeeroute.app
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_DEMO_EMAIL=demo@coffeeroute.app
SEED_DEMO_PASSWORD=demo-password-123
