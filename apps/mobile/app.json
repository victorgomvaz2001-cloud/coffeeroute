{
  "expo": {
    "name": "CoffeeRoute",
    "slug": "coffeeroute",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coffeeroute",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.coffeeroute",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4ECE2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.coffeeroute"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4ECE2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#15100D"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CoffeeRoute usa tu ubicación para mostrarte cafés de especialidad cerca de ti. Puedes desactivarlo cuando quieras en Ajustes."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
